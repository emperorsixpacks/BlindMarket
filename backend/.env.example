# Server
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://www.blindmarket.xyz

# Redis
REDIS_URL=redis://localhost:6379

# Auth
PRIVY_APP_ID=
AGENT_API_KEY=
JWT_SECRET=change-me-to-a-random-64-char-string
FOUNDER_ADDRESSES=

# CORS
CORS_ORIGIN=http://localhost:5173


# Verification (0G Compute Sealed Inference)
# OG_COMPUTE_PRIVATE_KEY must be set wherever auto-verification settles real
# escrow. Without it the verifier FAILS CLOSED (refuses to verify) in every
# environment. ALLOW_INSECURE_LOCAL_VERIFY=true re-enables the local
# auto-pass stub for local development only — production ignores the flag.
OG_COMPUTE_PRIVATE_KEY=
ALLOW_INSECURE_LOCAL_VERIFY=false

# Railway Sandboxes — ephemeral compute for agent tool execution
# Create tokens at https://railway.com/account/tokens
RAILWAY_API_TOKEN=
# Find environment ID in Railway dashboard URL: /project/<id>/environment/<envId>
RAILWAY_ENVIRONMENT_ID=
# Max minutes before an idle sandbox is auto-destroyed (default: 5)
SANDBOX_IDLE_TIMEOUT_MINUTES=5
# Max concurrent sandboxes per agent worker (default: 3)
SANDBOX_MAX_CONCURRENT=3
# Cost per second in micro-units (USDC 6 decimals) — for billing agents
SANDBOX_COST_PER_SECOND=1000
