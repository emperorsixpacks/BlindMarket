# Server
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://www.blindmarket.xyz

# Redis
REDIS_URL=redis://localhost:6379

# Auth
PRIVY_APP_ID=
AGENT_API_KEY=
JWT_SECRET=change-me-to-a-random-64-char-string
FOUNDER_ADDRESSES=

# CORS
CORS_ORIGIN=http://localhost:5173


# Verification (0G Compute Sealed Inference)
# OG_COMPUTE_PRIVATE_KEY must be set wherever auto-verification settles real
# escrow. Without it the verifier FAILS CLOSED (refuses to verify) in every
# environment. ALLOW_INSECURE_LOCAL_VERIFY=true re-enables the local
# auto-pass stub for local development only — production ignores the flag.
OG_COMPUTE_PRIVATE_KEY=
ALLOW_INSECURE_LOCAL_VERIFY=false
